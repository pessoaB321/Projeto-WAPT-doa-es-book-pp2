<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doações Book</title>
    <style>
        :root {
            color-scheme: light;
            --page: #d8bb8f;
            --surface: #fffaf2;
            --surface-border: #d7c3a5;
            --ink: #3f2a19;
            --muted: #76583b;
            --brand: #743513;
            --brand-hover: #5d2a0e;
            --accent: #e1bd7d;
            --shadow: 0 14px 34px rgba(96, 69, 36, 0.16);
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background: var(--page);
            color: var(--ink);
            font-family: Arial, sans-serif;
        }

        .topbar {
            background: var(--brand);
            color: var(--surface);
            border-bottom: 5px solid var(--accent);
        }

        .topbar-inner,
        main {
            width: min(100% - 40px, 1080px);
            margin: 0 auto;
        }

        .topbar-inner {
            min-height: 82px;
            display: flex;
            align-items: center;
        }

        .brand {
            color: inherit;
            font-size: 22px;
            font-weight: 700;
            text-decoration: none;
        }

        main {
            padding: 58px 0 72px;
        }

        .welcome {
            max-width: 680px;
            margin-bottom: 36px;
        }

        .eyebrow {
            margin: 0 0 10px;
            color: var(--brand);
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
        }

        h1 {
            margin: 0;
            font-size: clamp(32px, 5vw, 48px);
            line-height: 1.12;
        }

        .welcome p:last-child {
            max-width: 540px;
            margin: 14px 0 0;
            color: var(--muted);
            font-size: 17px;
            line-height: 1.6;
        }

        .section-title {
            margin: 0 0 16px;
            color: var(--brand);
            font-size: 18px;
        }

        .navigation {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .navigation a {
            min-height: 168px;
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 24px;
            border: 1px solid var(--surface-border);
            border-radius: 8px;
            background: var(--surface);
            box-shadow: var(--shadow);
            color: var(--ink);
            text-decoration: none;
            transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
        }

        .navigation a:hover {
            transform: translateY(-3px);
            border-color: var(--brand);
            box-shadow: 0 18px 38px rgba(96, 69, 36, 0.22);
        }

        .navigation a:focus-visible {
            outline: 3px solid var(--brand);
            outline-offset: 3px;
        }

        .navigation img {
            width: 72px;
            height: 72px;
            flex: 0 0 72px;
            object-fit: cover;
            border: 2px solid var(--accent);
            border-radius: 8px;
            background: #f1e3cc;
        }

        .card-title {
            display: block;
            margin-bottom: 6px;
            color: var(--brand);
            font-size: 19px;
            font-weight: 700;
        }

        .card-description {
            display: block;
            color: var(--muted);
            line-height: 1.5;
        }

        @media (max-width: 640px) {
            .topbar-inner,
            main {
                width: min(100% - 32px, 1080px);
            }

            main {
                padding: 40px 0 52px;
            }

            .navigation {
                grid-template-columns: 1fr;
            }

            .navigation a {
                min-height: 136px;
                padding: 20px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .navigation a {
                transition: none;
            }
        }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="/">Doações Book</a>
        </div>
    </header>

    <main>
        <section class="welcome" aria-labelledby="welcome-title">
            <p class="eyebrow">Compartilhe histórias</p>
            <h1 id="welcome-title">Bem-vindo ao Doações Book</h1>
            <p>Encontre livros para doar e mantenha as informações dos administradores em dia.</p>
        </section>

        <section aria-labelledby="navigation-title">
            <h2 class="section-title" id="navigation-title">Acessos</h2>
            <nav class="navigation" aria-label="Acessos principais">
                <a href="/admin">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTJ4Eia8QjS_LO1OcHH1P-Xwh0ajZZBzHSr8vAY0gXTmg&amp;s=10" alt="">
                    <span>
                        <span class="card-title">Administradores</span>
                        <span class="card-description">Cadastrar e gerenciar administradores.</span>
                    </span>
                </a>
                <a href="/livros/doar">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR_4v_LIt3JcJk3hhTDDj5_30VoXACyF517ad3MWl2lhA&amp;s=10" alt="">
                    <span>
                        <span class="card-title">Livros para doação</span>
                        <span class="card-description">Cadastrar ou consultar livros disponíveis.</span>
                    </span>
                </a>
            </nav>
        </section>
    </main>
</body>
</html>
