<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if editando}}Editar conta{{else}}Cadastrar conta{{/if}}</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; background-color: #d8bb8f; color: #3f2a19; }
        .container { max-width: 380px; margin: 0 auto; padding: 24px; border: 1px solid #000; border-radius: 10px; background-color: #f9f9f9; box-shadow: 4px 8px 20px 5px rgb(96, 69, 36); }
        .erro { background-color: #fff3f3; color: #8b1f1f; border: 1px solid #d98c8c; padding: 10px; border-radius: 6px; margin-bottom: 12px; }
        form { display: flex; flex-direction: column; gap: 10px; }
        input { padding: 8px; }
        button { padding: 8px 10px; cursor: pointer; background: #8b571c; color: white; border: none; border-radius: 4px; }
        a { color: #743513; }
    </style>
</head>
<body>
    <div class="container">
        {{#if erro}}
            <div class="erro">{{erro}}</div>
        {{/if}}

        {{#if editando}}
            <h1>Editar conta</h1>
            <form action="/contas/editar/{{conta.id}}" method="POST">
                <label for="nome">Nome</label>
                <input id="nome" type="text" name="nome" value="{{conta.nome}}" required>
                <label for="email">E-mail</label>
                <input id="email" type="email" name="email" value="{{conta.email}}" required>
                <label for="senha">Nova senha (opcional)</label>
                <input id="senha" type="password" name="senha" minlength="6" autocomplete="new-password">
                <small>Deixe em branco para manter a senha atual.</small>
                <button type="submit">Atualizar</button>
            </form>
        {{else}}
            <h1>Cadastrar conta</h1>
            <form action="/contas/novo" method="POST">
                <label for="nome">Nome</label>
                <input id="nome" type="text" name="nome" value="{{conta.nome}}" required>
                <label for="email">E-mail</label>
                <input id="email" type="email" name="email" value="{{conta.email}}" required>
                <label for="senha">Senha</label>
                <input id="senha" type="password" name="senha" minlength="6" autocomplete="new-password" required>
                <button type="submit">Salvar</button>
            </form>
        {{/if}}
        <p><a href="/contas">Voltar para a lista</a></p>
    </div>
</body>
</html>
